{
  "manifest_version": 3,
  "name": "Tablero de ruta - LoToDeliver",
  "short_name": "LoToDeliver",
  "version": "1.5.3",
  "description": "Trae los datos de Chess para el Tablero de ruta - LoToDeliver (entregas desde la app de choferes).",
  "key": "",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://portal.nextbyn.com/*",
    "https://logisticatotal.chesserp.com/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "Abrir el Tablero de ruta - LoToDeliver"
  },
  "externally_connectable": {
    "matches": [
      "https://jorgevichdarian.github.io/*"
    ]
  },
  "icons": {
    "16": "icono16.png",
    "48": "icono48.png",
    "128": "icono128.png"
  }
}
